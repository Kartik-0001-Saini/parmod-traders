# ==============================================================================
# Parmod Traders Smart Inventory - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or secret keys to GitHub!

# Supabase Database & Auth (Phase 2)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Session Pooler Connection String (Used for pg_dump backups in Phase 7)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Claude Vision API (Phase 6 - for reading purchase bills)
# Found in: Anthropic Console -> API Keys
ANTHROPIC_API_KEY=sk-ant-api-your-anthropic-key-here

# Showroom Owner PIN for Update Mode (Default: 1234)
NEXT_PUBLIC_DEFAULT_OWNER_PIN=1234
